# Copy this file to .env and fill it in. Never put .env in git.
POSTGRES_PASSWORD=change-this-to-a-long-random-password
# Used only to register devices and read admin reports. At least 16 characters.
ADMIN_TOKEN=change-this-to-another-long-random-text
# The web address that points to this server (create an A record at your domain provider)
DOMAIN=pos.example.com   # only needed for the internet server, not for the shop computer
# Which websites may call the API. Use * while testing, then your own addresses, comma separated.
ALLOWED_ORIGINS=*
